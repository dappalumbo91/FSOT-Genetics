cabal-version:      3.0
name:               fsot-genetics
version:            0.1.0.0
synopsis:           FSOT genetics chem-link and contact laws (compile-time locks)
license:            Apache-2.0
author:             Damian Arthur Palumbo
maintainer:         dappalumbo91@users.noreply.github.com
category:           Science
build-type:         Simple
extra-doc-files:    README.md

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
      FSOT.Genetics.ChemLink
    , FSOT.Genetics.Contact
    , FSOT.Genetics.Claim
  build-depends:    base >= 4.17 && < 5
  hs-source-dirs:   src
  default-language: Haskell2010

executable fsot-genetics-check
  import:           warnings
  main-is:          Main.hs
  build-depends:
      base >= 4.17 && < 5
    , fsot-genetics
  hs-source-dirs:   app
  default-language: Haskell2010
